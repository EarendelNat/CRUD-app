# Copy to .env and edit. Every value below has a working default.

# Port the server listens on
PORT=3000

# The code people must enter to join your group
INVITE_CODE=STEP2026

# Hard cap on group size
MAX_MEMBERS=10

# Decides "what day is it" and when the week rolls over. Set this to your
# group's timezone -- a server in UTC would otherwise roll the week over at
# 8am Monday for a group in Singapore.
APP_TZ=Asia/Singapore

# Where the SQLite file lives. On a host like Fly or Railway, point this at a
# mounted volume or the database is wiped on every redeploy.
DB_PATH=./data/app.db
